NODE_ENV=development
PORT=3000
APP_NAME=GRX Product Store Backend
APP_VERSION=1.0.0
APP_DESCRIPTION=Feature-based NestJS boilerplate
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=grx_productstore
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1d
# Rate limiting (per IP): window length ms, max requests per window for default routes
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=150
# Behind reverse proxy: trust X-Forwarded-* so throttling keys on real client IP
# TRUST_PROXY=true

# Enterprise Loyalty — order status webhook (same secret as GRX_WEBHOOK_SECRET on loyalty)
LOYALTY_WEBHOOK_URL=http://localhost:4000/api/v1/integrations/grx/order-events
LOYALTY_WEBHOOK_SECRET=change-me-grx-webhook-secret
LOYALTY_WEBHOOK_TIMEOUT_MS=10000

# Fixed public base URL for uploaded file links (e.g. http://192.168.1.50:4001).
# When unset, falls back to the uploading request's Host header — fine for a single
# local browser, but bakes in "localhost" (or whatever host was used) permanently
# into the stored URL, breaking access from any other device (phones, emulators).
# GRX_PUBLIC_BASE_URL=http://192.168.1.50:4001
